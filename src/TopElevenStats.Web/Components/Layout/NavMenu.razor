@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">
            <i class="bi bi-trophy me-2"></i>Top Eleven Stats
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door me-2"></i> Dashboard
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/players">
                        <i class="bi bi-people me-2"></i> Hráči
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/import-players">
                        <i class="bi bi-upload me-2"></i> Import hráčů
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/stats">
                        <i class="bi bi-graph-up me-2"></i> Statistiky
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/stats/add">
                        <i class="bi bi-plus-circle me-2"></i> Přidat statistiky
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/compare">
                        <i class="bi bi-people me-2"></i> Srovnání
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/season">
                        <i class="bi bi-calendar-plus me-2"></i> Sezóna
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="achievements">
                        <span class="bi bi-trophy-fill me-2" aria-hidden="true"></span> Achievementy
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin" Context="adminCtx">
                    <Authorized>
                        <hr class="nav-divider" />
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="/admin">
                                <i class="bi bi-shield-lock me-2"></i> Admin
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <hr class="nav-divider" />

                <div class="nav-item px-3">
                    <span class="nav-link text-muted small">
                        <i class="bi bi-person-circle me-1"></i>@context.User.Identity?.Name
                    </span>
                </div>
                <div class="nav-item px-3">
                    <a class="nav-link" href="/logout">
                        <i class="bi bi-box-arrow-right me-2"></i> Odhlásit
                    </a>
                </div>

                <ThemePicker />
                <UiLibrarySwitcher />
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/login">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Přihlásit
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/register">
                        <i class="bi bi-person-plus me-2"></i> Registrace
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

<style>
    .nav-divider { border-color: rgba(255,255,255,.15); margin: .5rem 1rem; }
</style>
