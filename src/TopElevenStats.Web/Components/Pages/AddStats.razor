@page "/stats/add"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContextGames> DbFactory
@inject ToastService Toast

<PageTitle>Přidat statistiky — TopElevenStats</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-plus-circle-fill"></i> Přidat statistiky sezóny</h3>
</div>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Načítám…</span>
    </div>
}
else if (_account is null)
{
    <div class="ui-panel ui-anim-fade-up p-3">
        <div class="d-flex align-items-center gap-2 text-warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>Nejprve vytvoř účet a hráče.</span>
        </div>
    </div>
}
else
{
    <!-- Player selector -->
    <div class="ui-panel ui-anim-fade-up">
        <div class="ui-panel-header">
            <span class="ui-panel-title">
                <i class="bi bi-person-circle text-accent"></i>
                Sezóna @_account.CurrentSeason – Výběr hráče
            </span>
        </div>
        <div class="p-3">
            <select class="form-select form-select-sm"
                    style="max-width:420px;background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                    value="@_selectedPlayerId" @onchange="OnPlayerChanged">
                <option value="">— vyber hráče —</option>
                @foreach (var p in _players)
                {
                    <option value="@p.Guid">@p.Name (@p.Roles) OVR @p.Ovr</option>
                }
            </select>
        </div>
    </div>

    @if (_selectedPlayer is not null)
    {
        <!-- Stats form -->
        <div class="ui-panel ui-anim-fade-up">
            <div class="ui-panel-header">
                <span class="ui-panel-title">
                    <i class="bi bi-pencil-square text-accent"></i>
                    @_selectedPlayer.Name – Sezóna @_account.CurrentSeason
                    @if (_selectedPlayer.IsGoalkeeper) { <span class="badge bg-success ms-2">GK</span> }
                    @if (_selectedPlayer.IsElite) { <span class="badge bg-warning text-dark ms-2">ELITNÍ</span> }
                </span>
            </div>
            <div class="p-3">
                @if (_existingStats is not null)
                {
                    <div class="d-flex align-items-center gap-2 text-warning mb-3">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span class="small">Statistiky pro tuto sezónu již existují – přepíšou se uložením.</span>
                    </div>
                }

                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <label class="form-label small text-muted">Průměrné hodnocení</label>
                        <input type="number" step="0.1" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                               @bind="_s.AvgRating" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small text-muted">Odehrané zápasy</label>
                        <input type="number" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                               @bind="_s.MatchesPlayed" />
                    </div>
                    @if (!_selectedPlayer.IsGoalkeeper)
                    {
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted">Góly</label>
                            <input type="number" class="form-control form-control-sm"
                                   style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                                   @bind="_goalsInput" />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted">xG90</label>
                            <input type="number" step="0.1" class="form-control form-control-sm"
                                   style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                                   @bind="_xg90Input" />
                        </div>
                    }
                    <div class="col-6 col-md-3">
                        <label class="form-label small text-muted">Asistence</label>
                        <input type="number" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                               @bind="_s.Assists" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small text-muted">Klíčové přihrávky</label>
                        <input type="number" step="0.1" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                               @bind="_s.KeyPasses" />
                    </div>
                    @if (_selectedPlayer.IsGoalkeeper)
                    {
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted">Čistá konta</label>
                            <input type="number" class="form-control form-control-sm"
                                   style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                                   @bind="_cleanSheetsInput" />
                        </div>
                    }
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-4 col-md-2">
                        <label class="form-label small text-muted">Zranění</label>
                        <input type="number" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                               @bind="_s.Injuries" />
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label small text-muted">Žluté karty</label>
                        <input type="number" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                               @bind="_s.YellowCards" />
                    </div>
                    <div class="col-4 col-md-2">
                        <label class="form-label small text-muted">Červené karty</label>
                        <input type="number" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                               @bind="_s.RedCards" />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-4 col-md-3">
                        <label class="form-label small text-muted">S hráčem %</label>
                        <input type="number" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                               @bind="_s.WinRatioWith" />
                    </div>
                    <div class="col-4 col-md-3">
                        <label class="form-label small text-muted">Bez hráče %</label>
                        <input type="number" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                               @bind="_s.WinRatioWithout" />
                    </div>
                    <div class="col-4 col-md-3">
                        <label class="form-label small text-muted">Týmový průměr %</label>
                        <input type="number" class="form-control form-control-sm"
                               style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                               @bind="_s.TeamAverage" />
                    </div>
                </div>

                <button class="btn btn-success btn-sm" @onclick="Save">
                    <i class="bi bi-floppy me-1"></i>Uložit statistiky
                </button>
            </div>
        </div>
    }
}

@code {
    TopElevenAccount? _account;
    List<TopElevenPlayer> _players = new();
    Guid? _selectedPlayerId;
    TopElevenPlayer? _selectedPlayer;
    TopElevenSeasonStats? _existingStats;
    TopElevenSeasonStats _s = new();
    int? _goalsInput;
    decimal? _xg90Input;
    int? _cleanSheetsInput;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _account = await db.TopElevenAccounts.FirstOrDefaultAsync();
        if (_account is not null)
            _players = await db.TopElevenPlayers
                .Where(p => p.AccountId == _account.Guid)
                .OrderByDescending(p => p.IsGoalkeeper)
                .ThenByDescending(p => p.Ovr)
                .ToListAsync();
        _loading = false;
    }

    async Task OnPlayerChanged(ChangeEventArgs e)
    {
        _selectedPlayerId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        await LoadPlayer();
    }

    async Task LoadPlayer()
    {
        if (_selectedPlayerId is null || _account is null) { _selectedPlayer = null; return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        _selectedPlayer = _players.FirstOrDefault(p => p.Guid == _selectedPlayerId);
        _existingStats = await db.TopElevenSeasonStats
            .FirstOrDefaultAsync(s => s.PlayerId == _selectedPlayerId && s.Season == _account.CurrentSeason);
        _s = _existingStats is not null
            ? new TopElevenSeasonStats
            {
                AvgRating = _existingStats.AvgRating,
                MatchesPlayed = _existingStats.MatchesPlayed,
                Assists = _existingStats.Assists,
                KeyPasses = _existingStats.KeyPasses,
                Injuries = _existingStats.Injuries,
                YellowCards = _existingStats.YellowCards,
                RedCards = _existingStats.RedCards,
                WinRatioWith = _existingStats.WinRatioWith,
                WinRatioWithout = _existingStats.WinRatioWithout,
                TeamAverage = _existingStats.TeamAverage,
            }
            : new();
        _goalsInput = _existingStats?.Goals;
        _xg90Input = _existingStats?.Xg90;
        _cleanSheetsInput = _existingStats?.CleanSheets;
        StateHasChanged();
    }

    async Task Save()
    {
        if (_selectedPlayer is null || _account is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();

        TopElevenSeasonStats? entity = _existingStats is null ? null
            : await db.TopElevenSeasonStats.FindAsync(_existingStats.Guid);

        if (entity is null)
        {
            entity = new TopElevenSeasonStats
            {
                PlayerId = _selectedPlayer.Guid,
                Season = _account.CurrentSeason,
            };
            db.TopElevenSeasonStats.Add(entity);
        }

        entity.AvgRating = _s.AvgRating;
        entity.MatchesPlayed = _s.MatchesPlayed;
        entity.Assists = _s.Assists;
        entity.KeyPasses = _s.KeyPasses;
        entity.Injuries = _s.Injuries;
        entity.YellowCards = _s.YellowCards;
        entity.RedCards = _s.RedCards;
        entity.WinRatioWith = _s.WinRatioWith;
        entity.WinRatioWithout = _s.WinRatioWithout;
        entity.TeamAverage = _s.TeamAverage;

        if (_selectedPlayer.IsGoalkeeper)
            entity.CleanSheets = _cleanSheetsInput;
        else
        {
            entity.Goals = _goalsInput;
            entity.Xg90 = _xg90Input;
        }

        await db.SaveChangesAsync();
        _existingStats = entity;
        Toast.ShowSuccess("Statistiky uloženy!", string.Empty);
    }
}
