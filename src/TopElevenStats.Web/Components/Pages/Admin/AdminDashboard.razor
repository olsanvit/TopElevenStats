@page "/admin"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]

@using MercenariesAndBeasts.Infrastructure
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SharedServices.Models.TopEleven
@inject UserManager<AppUser> UserManager
@inject IDbContextFactory<AppDbContextGames> DbFactory
@inject NavigationManager Nav
@inject ToastService Toast

<PageTitle>Admin — TopElevenStats</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="m-0">Admin — TopElevenStats</h4>
</div>

@if (_loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <!-- Statistiky -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-primary">@_userCount</div>
                    <div class="text-muted small">Uživatelé</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-info">@_accountCount</div>
                    <div class="text-muted small">TE účty</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-success">@_playerCount</div>
                    <div class="text-muted small">Hráči</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body py-2">
                    <div class="fs-4 fw-bold text-warning">@_seasonStatsCount</div>
                    <div class="text-muted small">Sezónní záznamy</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Uživatelé -->
        <div class="col-md-5">
            <div class="card">
                <div class="card-header fw-bold">Uživatelé (@_userCount)</div>
                <div class="card-body p-0">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-secondary">
                            <tr><th>Email</th><th>Admin</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var u in _users)
                            {
                                <tr>
                                    <td class="small">@u.Email</td>
                                    <td>
                                        @if (u.IsAdmin)
                                        { <span class="badge bg-warning text-dark">Admin</span> }
                                        else
                                        { <span class="badge bg-secondary">User</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TE Účty + správa sezóny -->
        <div class="col-md-7">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Top Eleven účty</span>
                    @if (!string.IsNullOrEmpty(_accountMsg))
                    {
                        <span class="text-success small">@_accountMsg</span>
                    }
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>Název účtu</th>
                                <th class="text-center">Sezóna</th>
                                <th class="text-end">Hráči</th>
                                <th class="text-end">Záznamy</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var acc in _accounts)
                            {
                                <tr>
                                    <td>@acc.Account.Name</td>
                                    <td class="text-center">
                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                            <button class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                    @onclick="() => ChangeSeasonAsync(acc.Account.Guid, -1)"
                                                    disabled="@(acc.Account.CurrentSeason <= 1)">-</button>
                                            <span class="fw-bold">@acc.Account.CurrentSeason</span>
                                            <button class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                    @onclick="() => ChangeSeasonAsync(acc.Account.Guid, +1)">+</button>
                                        </div>
                                    </td>
                                    <td class="text-end small">@acc.PlayerCount</td>
                                    <td class="text-end small">@acc.StatsCount</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ConfirmDeleteAccount(acc.Account.Guid)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Potvrzení smazání -->
    @if (_deleteAccountGuid.HasValue)
    {
        <div class="alert alert-danger mt-3 d-flex align-items-center justify-content-between">
            <span>Opravdu smazat tento TE účet včetně všech hráčů a statistik?</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-danger" @onclick="DeleteAccountAsync">Smazat</button>
                <button class="btn btn-sm btn-secondary" @onclick="() => _deleteAccountGuid = null">Zrušit</button>
            </div>
        </div>
    }

    <!-- Top hráči -->
    <div class="card mt-3">
        <div class="card-header fw-bold">Top 10 hráčů (podle OVR)</div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-secondary">
                    <tr><th>Hráč</th><th>OVR</th><th>Role</th><th>Věk</th><th>Elitní</th><th>Účet</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in _topPlayers)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td><span class="badge bg-primary">@p.Ovr</span></td>
                            <td><span class="badge bg-secondary">@p.Roles</span></td>
                            <td>@p.Age</td>
                            <td>@(p.IsElite ? "⭐" : "")</td>
                            <td class="small text-muted">@p.Account?.Name</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private string _accountMsg = string.Empty;
    private Guid? _deleteAccountGuid;

    private int _userCount, _accountCount, _playerCount, _seasonStatsCount;
    private List<AppUser> _users = new();

    private record AccountRow(TopElevenAccount Account, int PlayerCount, int StatsCount);
    private List<AccountRow> _accounts = new();
    private List<TopElevenPlayer> _topPlayers = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _users = UserManager.Users.OrderByDescending(u => u.IsAdmin).ToList();
        _userCount = _users.Count;

        await using var db = await DbFactory.CreateDbContextAsync();
        _accountCount    = await db.TopElevenAccounts.CountAsync();
        _playerCount     = await db.TopElevenPlayers.CountAsync();
        _seasonStatsCount = await db.TopElevenSeasonStats.CountAsync();

        var accounts = await db.TopElevenAccounts.ToListAsync();
        _accounts = accounts.Select(a => new AccountRow(
            a,
            db.TopElevenPlayers.Count(p => p.AccountId == a.Guid),
            db.TopElevenSeasonStats.Count(s => s.Player.AccountId == a.Guid)
        )).ToList();

        _topPlayers = await db.TopElevenPlayers
            .Include(p => p.Account)
            .OrderByDescending(p => p.Ovr)
            .Take(10)
            .ToListAsync();

        _loading = false;
    }

    private async Task ChangeSeasonAsync(Guid accountGuid, int delta)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var acc = await db.TopElevenAccounts.FindAsync(accountGuid);
            if (acc is null) return;
            acc.CurrentSeason = Math.Max(1, acc.CurrentSeason + delta);
            await db.SaveChangesAsync();
            _accountMsg = $"Sezóna účtu '{acc.Name}' → {acc.CurrentSeason}";
            Toast.ShowSuccess("Uloženo", _accountMsg);
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.ShowError("Chyba", $"Nepodařilo se uložit sezónu: {ex.Message}");
        }
    }

    private void ConfirmDeleteAccount(Guid guid) => _deleteAccountGuid = guid;

    private async Task DeleteAccountAsync()
    {
        if (_deleteAccountGuid is null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var acc = await db.TopElevenAccounts
                .Include(a => a.Players).ThenInclude(p => p.SeasonStats)
                .FirstOrDefaultAsync(a => a.Guid == _deleteAccountGuid);
            if (acc is null) { _deleteAccountGuid = null; return; }

            db.TopElevenAccounts.Remove(acc);
            await db.SaveChangesAsync();
            _accountMsg = $"Účet '{acc.Name}' smazán.";
            Toast.ShowSuccess("Smazáno", _accountMsg);
            _deleteAccountGuid = null;
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Toast.ShowError("Chyba", $"Nepodařilo se smazat účet: {ex.Message}");
        }
    }
}
