@page "/compare"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContextGames> DbFactory
@inject ToastService Toast

<PageTitle>Srovnání hráčů — TopElevenStats</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-people"></i> Srovnání hráčů</h3>
</div>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Načítám hráče…</span>
    </div>
}
else
{
    <!-- Player selectors -->
    <div class="ui-panel ui-anim-fade-up">
        <div class="ui-panel-header">
            <span class="ui-panel-title">
                <i class="bi bi-person-lines-fill text-accent"></i>
                Výběr hráčů
            </span>
        </div>
        <div class="p-3">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label small text-muted">Hráč A</label>
                    <select class="form-select form-select-sm"
                            style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                            value="@_leftId" @onchange="OnLeftChanged">
                        <option value="">— vyber hráče A —</option>
                        @foreach (var p in _players)
                        {
                            <option value="@p.Guid">@p.Name (@p.Roles) OVR @p.Ovr@(p.IsGoalkeeper ? " · GK" : "")@(p.IsElite ? " · ELITE" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small text-muted">Hráč B</label>
                    <select class="form-select form-select-sm"
                            style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                            value="@_rightId" @onchange="OnRightChanged">
                        <option value="">— vyber hráče B —</option>
                        @foreach (var p in _players)
                        {
                            <option value="@p.Guid">@p.Name (@p.Roles) OVR @p.Ovr@(p.IsGoalkeeper ? " · GK" : "")@(p.IsElite ? " · ELITE" : "")</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (_leftPlayer is not null && _rightPlayer is not null)
    {
        @{
            var commonSeasons = _leftStats
                .Select(s => s.Season)
                .Intersect(_rightStats.Select(s => s.Season))
                .OrderBy(s => s)
                .ToList();
        }

        @if (commonSeasons.Count == 0)
        {
            <div class="ui-panel ui-anim-fade-up p-3">
                <div class="d-flex align-items-center gap-2 text-muted">
                    <i class="bi bi-info-circle"></i>
                    <span>Tito hráči nemají žádné společné sezóny.</span>
                </div>
            </div>
        }
        else
        {
            <div class="ui-panel ui-anim-fade-up">
                <div class="ui-panel-header">
                    <span class="ui-panel-title">
                        <i class="bi bi-table text-accent"></i>
                        Srovnání po sezónách
                    </span>
                    <div class="d-flex gap-2">
                        <span class="badge" style="background:rgba(99,102,241,0.2);color:#a5b4fc">@_leftPlayer.Name</span>
                        <span class="badge" style="background:rgba(239,68,68,0.2);color:#fca5a5">@_rightPlayer.Name</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Sezóna</th>
                                <th colspan="2" class="text-center">Hodnocení</th>
                                <th colspan="2" class="text-center">Zápasy</th>
                                @if (_leftPlayer.IsGoalkeeper || _rightPlayer.IsGoalkeeper)
                                {
                                    <th colspan="2" class="text-center">Čistá konta / Góly</th>
                                }
                                else
                                {
                                    <th colspan="2" class="text-center">Góly</th>
                                }
                                <th colspan="2" class="text-center">Asistence</th>
                                <th colspan="2" class="text-center">S hráčem %</th>
                            </tr>
                            <tr>
                                <th></th>
                                <th style="color:#a5b4fc">@_leftPlayer.Name</th>
                                <th style="color:#fca5a5">@_rightPlayer.Name</th>
                                <th style="color:#a5b4fc">@_leftPlayer.Name</th>
                                <th style="color:#fca5a5">@_rightPlayer.Name</th>
                                <th style="color:#a5b4fc">@_leftPlayer.Name</th>
                                <th style="color:#fca5a5">@_rightPlayer.Name</th>
                                <th style="color:#a5b4fc">@_leftPlayer.Name</th>
                                <th style="color:#fca5a5">@_rightPlayer.Name</th>
                                <th style="color:#a5b4fc">@_leftPlayer.Name</th>
                                <th style="color:#fca5a5">@_rightPlayer.Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var season in commonSeasons)
                            {
                                var L = _leftStats.First(s => s.Season == season);
                                var R = _rightStats.First(s => s.Season == season);
                                int lGoalStat = _leftPlayer.IsGoalkeeper ? (L.CleanSheets ?? 0) : (L.Goals ?? 0);
                                int rGoalStat = _rightPlayer.IsGoalkeeper ? (R.CleanSheets ?? 0) : (R.Goals ?? 0);
                                string lGoalDisplay = _leftPlayer.IsGoalkeeper ? (L.CleanSheets?.ToString() ?? "—") : (L.Goals?.ToString() ?? "—");
                                string rGoalDisplay = _rightPlayer.IsGoalkeeper ? (R.CleanSheets?.ToString() ?? "—") : (R.Goals?.ToString() ?? "—");
                                <tr>
                                    <td class="fw-bold">@season</td>
                                    <td class="@(L.AvgRating > R.AvgRating ? "text-success fw-semibold" : "text-muted small")">@L.AvgRating.ToString("F1")</td>
                                    <td class="@(R.AvgRating > L.AvgRating ? "text-success fw-semibold" : "text-muted small")">@R.AvgRating.ToString("F1")</td>
                                    <td class="@(L.MatchesPlayed > R.MatchesPlayed ? "text-success fw-semibold" : "text-muted small")">@L.MatchesPlayed</td>
                                    <td class="@(R.MatchesPlayed > L.MatchesPlayed ? "text-success fw-semibold" : "text-muted small")">@R.MatchesPlayed</td>
                                    <td class="@(lGoalStat > rGoalStat ? "text-success fw-semibold" : "text-muted small")">@lGoalDisplay</td>
                                    <td class="@(rGoalStat > lGoalStat ? "text-success fw-semibold" : "text-muted small")">@rGoalDisplay</td>
                                    <td class="@(L.Assists > R.Assists ? "text-success fw-semibold" : "text-muted small")">@L.Assists</td>
                                    <td class="@(R.Assists > L.Assists ? "text-success fw-semibold" : "text-muted small")">@R.Assists</td>
                                    <td class="@(L.WinRatioWith > R.WinRatioWith ? "text-success fw-semibold" : "text-muted small")">@L.WinRatioWith</td>
                                    <td class="@(R.WinRatioWith > L.WinRatioWith ? "text-success fw-semibold" : "text-muted small")">@R.WinRatioWith</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else if (_leftPlayer is not null || _rightPlayer is not null)
    {
        <div class="ui-panel ui-anim-fade-up p-3">
            <div class="d-flex align-items-center gap-2 text-muted">
                <i class="bi bi-info-circle"></i>
                <span>Vyber oba hráče pro zobrazení srovnání.</span>
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    List<TopElevenPlayer> _players = new();

    Guid? _leftId;
    TopElevenPlayer? _leftPlayer;
    List<TopElevenSeasonStats> _leftStats = new();

    Guid? _rightId;
    TopElevenPlayer? _rightPlayer;
    List<TopElevenSeasonStats> _rightStats = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _players = await db.TopElevenPlayers
            .OrderByDescending(p => p.Ovr)
            .ToListAsync();
        _loading = false;
    }

    async Task OnLeftChanged(ChangeEventArgs e)
    {
        _leftId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        _leftPlayer = null;
        _leftStats = new();

        if (_leftId is null) return;

        _leftPlayer = _players.FirstOrDefault(p => p.Guid == _leftId);

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _leftStats = await db.TopElevenSeasonStats
                .Where(s => s.PlayerId == _leftId)
                .OrderBy(s => s.Season)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError("Chyba", $"Nepodařilo se načíst statistiky: {ex.Message}");
        }

        StateHasChanged();
    }

    async Task OnRightChanged(ChangeEventArgs e)
    {
        _rightId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        _rightPlayer = null;
        _rightStats = new();

        if (_rightId is null) return;

        _rightPlayer = _players.FirstOrDefault(p => p.Guid == _rightId);

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _rightStats = await db.TopElevenSeasonStats
                .Where(s => s.PlayerId == _rightId)
                .OrderBy(s => s.Season)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError("Chyba", $"Nepodařilo se načíst statistiky: {ex.Message}");
        }

        StateHasChanged();
    }
}
