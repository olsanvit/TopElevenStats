@page "/compare"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using ApexCharts
@inject IDbContextFactory<AppDbContextGames> DbFactory
@inject ToastService Toast

<PageTitle>Srovnání hráčů — TopElevenStats</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-people"></i> Srovnání hráčů</h3>
</div>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Načítám hráče…</span>
    </div>
}
else
{
    <!-- Player selectors -->
    <div class="ui-panel ui-anim-fade-up">
        <div class="ui-panel-header">
            <span class="ui-panel-title">
                <i class="bi bi-person-lines-fill text-accent"></i>
                Výběr hráčů
            </span>
        </div>
        <div class="p-3">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label small text-muted">Hráč A</label>
                    <select class="form-select form-select-sm"
                            style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                            value="@_leftId" @onchange="OnLeftChanged">
                        <option value="">— vyber hráče A —</option>
                        @foreach (var p in _players)
                        {
                            <option value="@p.Guid">@p.Name (@p.Roles) OVR @p.Ovr@(p.IsGoalkeeper ? " · GK" : "")@(p.IsElite ? " · ELITE" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label small text-muted">Hráč B</label>
                    <select class="form-select form-select-sm"
                            style="background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                            value="@_rightId" @onchange="OnRightChanged">
                        <option value="">— vyber hráče B —</option>
                        @foreach (var p in _players)
                        {
                            <option value="@p.Guid">@p.Name (@p.Roles) OVR @p.Ovr@(p.IsGoalkeeper ? " · GK" : "")@(p.IsElite ? " · ELITE" : "")</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (_leftPlayer is not null && _rightPlayer is not null)
    {
        @* ── Career summary ──────────────────────────────────── *@
        @if (_leftStats.Any() || _rightStats.Any())
        {
            var lRating   = _leftStats.Any()  ? _leftStats.Average(s => (double)s.AvgRating)   : 0;
            var rRating   = _rightStats.Any() ? _rightStats.Average(s => (double)s.AvgRating)  : 0;
            var lGoals    = _leftStats.Any()  ? (double)(_leftPlayer.IsGoalkeeper  ? _leftStats.Sum(s => s.CleanSheets ?? 0)  : _leftStats.Sum(s => s.Goals ?? 0))  : 0;
            var rGoals    = _rightStats.Any() ? (double)(_rightPlayer.IsGoalkeeper ? _rightStats.Sum(s => s.CleanSheets ?? 0) : _rightStats.Sum(s => s.Goals ?? 0)) : 0;
            var lAssists  = _leftStats.Any()  ? (double)_leftStats.Sum(s => s.Assists)   : 0;
            var rAssists  = _rightStats.Any() ? (double)_rightStats.Sum(s => s.Assists)  : 0;
            var lMatches  = _leftStats.Any()  ? (double)_leftStats.Sum(s => s.MatchesPlayed)  : 0;
            var rMatches  = _rightStats.Any() ? (double)_rightStats.Sum(s => s.MatchesPlayed) : 0;
            var lWinR     = _leftStats.Any()  ? _leftStats.Average(s => (double)s.WinRatioWith)  : 0;
            var rWinR     = _rightStats.Any() ? _rightStats.Average(s => (double)s.WinRatioWith) : 0;

            <div class="row g-3 ui-anim-fade-up mb-3">
                @* Summary cards *@
                <div class="col-12">
                    <div class="ui-panel">
                        <div class="ui-panel-header">
                            <span class="ui-panel-title">
                                <i class="bi bi-trophy text-accent"></i>
                                Kariérní souhrn
                            </span>
                        </div>
                        <div class="table-responsive p-2">
                            <table class="table table-sm mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th style="color:#a5b4fc">@_leftPlayer.Name</th>
                                        <th class="text-center text-muted">Kategorie</th>
                                        <th class="text-end" style="color:#fca5a5">@_rightPlayer.Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @CompareRow("OVR", _leftPlayer.Ovr, _rightPlayer.Ovr, higher: true)
                                    @CompareRow("Prům. hodnocení", Math.Round(lRating, 2), Math.Round(rRating, 2), higher: true)
                                    @CompareRow("Celkem zápasů", (int)lMatches, (int)rMatches, higher: true)
                                    @CompareRow(_leftPlayer.IsGoalkeeper ? "Čistá konta" : "Góly", (int)lGoals, (int)rGoals, higher: true)
                                    @CompareRow("Asistence", (int)lAssists, (int)rAssists, higher: true)
                                    @CompareRow("Win% s hráčem", (int)Math.Round(lWinR), (int)Math.Round(rWinR), higher: true)
                                    @CompareRow("Věk", _leftPlayer.Age, _rightPlayer.Age, higher: false)
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @* Radar chart *@
                @if (_leftStats.Any() && _rightStats.Any())
                {
                    var radarItems = new List<RadarItem>
                    {
                        new("OVR",         NormOvr(_leftPlayer.Ovr),  NormOvr(_rightPlayer.Ovr)),
                        new("Hodnocení",   NormRating(lRating),        NormRating(rRating)),
                        new("Zápasy/sez.", NormMatches(lMatches / _leftStats.Count), NormMatches(rMatches / _rightStats.Count)),
                        new("Góly/sez.",   NormGoals(lGoals / _leftStats.Count),     NormGoals(rGoals / _rightStats.Count)),
                        new("Asistenece",  NormGoals(lAssists / _leftStats.Count),   NormGoals(rAssists / _rightStats.Count)),
                        new("Win%",        NormWin(lWinR),             NormWin(rWinR)),
                    };
                    <div class="col-lg-6">
                        <div class="ui-panel">
                            <div class="ui-panel-header">
                                <span class="ui-panel-title"><i class="bi bi-radar text-accent"></i> Radar</span>
                            </div>
                            <ApexChart TItem="RadarItem" Options="_radarOptions" Height="300">
                                <ApexPointSeries TItem="RadarItem" Name="@_leftPlayer.Name"
                                    Items="radarItems" XValue="@(e => e.Label)"
                                    YValue="@(e => (decimal?)e.Left)" SeriesType="SeriesType.Radar" />
                                <ApexPointSeries TItem="RadarItem" Name="@_rightPlayer.Name"
                                    Items="radarItems" XValue="@(e => e.Label)"
                                    YValue="@(e => (decimal?)e.Right)" SeriesType="SeriesType.Radar" />
                            </ApexChart>
                        </div>
                    </div>
                }
            </div>
        }

        var commonSeasons = _leftStats
            .Select(s => s.Season)
            .Intersect(_rightStats.Select(s => s.Season))
            .OrderBy(s => s)
            .ToList();

        @if (commonSeasons.Count == 0)
        {
            <div class="ui-panel ui-anim-fade-up p-3">
                <div class="d-flex align-items-center gap-2 text-muted">
                    <i class="bi bi-info-circle"></i>
                    <span>Tito hráči nemají žádné společné sezóny.</span>
                </div>
            </div>
        }
        else
        {
            <div class="ui-panel ui-anim-fade-up">
                <div class="ui-panel-header">
                    <span class="ui-panel-title">
                        <i class="bi bi-table text-accent"></i>
                        Srovnání po sezónách
                    </span>
                    <div class="d-flex gap-2">
                        <a href="/players/@_leftPlayer.Guid" class="text-decoration-none">
                            <span class="badge" style="background:rgba(99,102,241,0.2);color:#a5b4fc">@_leftPlayer.Name</span>
                        </a>
                        <a href="/players/@_rightPlayer.Guid" class="text-decoration-none">
                            <span class="badge" style="background:rgba(239,68,68,0.2);color:#fca5a5">@_rightPlayer.Name</span>
                        </a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Sezóna</th>
                                <th colspan="2" class="text-center">Hodnocení</th>
                                <th colspan="2" class="text-center">Zápasy</th>
                                @if (_leftPlayer.IsGoalkeeper || _rightPlayer.IsGoalkeeper)
                                {
                                    <th colspan="2" class="text-center">Čistá konta / Góly</th>
                                }
                                else
                                {
                                    <th colspan="2" class="text-center">Góly</th>
                                }
                                <th colspan="2" class="text-center">Asistence</th>
                                <th colspan="2" class="text-center">S hráčem %</th>
                            </tr>
                            <tr>
                                <th></th>
                                <th style="color:#a5b4fc"><a href="/players/@_leftPlayer.Guid" class="text-decoration-none" style="color:inherit">@_leftPlayer.Name</a></th>
                                <th style="color:#fca5a5"><a href="/players/@_rightPlayer.Guid" class="text-decoration-none" style="color:inherit">@_rightPlayer.Name</a></th>
                                <th style="color:#a5b4fc"><a href="/players/@_leftPlayer.Guid" class="text-decoration-none" style="color:inherit">@_leftPlayer.Name</a></th>
                                <th style="color:#fca5a5"><a href="/players/@_rightPlayer.Guid" class="text-decoration-none" style="color:inherit">@_rightPlayer.Name</a></th>
                                <th style="color:#a5b4fc"><a href="/players/@_leftPlayer.Guid" class="text-decoration-none" style="color:inherit">@_leftPlayer.Name</a></th>
                                <th style="color:#fca5a5"><a href="/players/@_rightPlayer.Guid" class="text-decoration-none" style="color:inherit">@_rightPlayer.Name</a></th>
                                <th style="color:#a5b4fc"><a href="/players/@_leftPlayer.Guid" class="text-decoration-none" style="color:inherit">@_leftPlayer.Name</a></th>
                                <th style="color:#fca5a5"><a href="/players/@_rightPlayer.Guid" class="text-decoration-none" style="color:inherit">@_rightPlayer.Name</a></th>
                                <th style="color:#a5b4fc"><a href="/players/@_leftPlayer.Guid" class="text-decoration-none" style="color:inherit">@_leftPlayer.Name</a></th>
                                <th style="color:#fca5a5"><a href="/players/@_rightPlayer.Guid" class="text-decoration-none" style="color:inherit">@_rightPlayer.Name</a></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var season in commonSeasons)
                            {
                                var L = _leftStats.First(s => s.Season == season);
                                var R = _rightStats.First(s => s.Season == season);
                                int lGoalStat = _leftPlayer.IsGoalkeeper ? (L.CleanSheets ?? 0) : (L.Goals ?? 0);
                                int rGoalStat = _rightPlayer.IsGoalkeeper ? (R.CleanSheets ?? 0) : (R.Goals ?? 0);
                                string lGoalDisplay = _leftPlayer.IsGoalkeeper ? (L.CleanSheets?.ToString() ?? "—") : (L.Goals?.ToString() ?? "—");
                                string rGoalDisplay = _rightPlayer.IsGoalkeeper ? (R.CleanSheets?.ToString() ?? "—") : (R.Goals?.ToString() ?? "—");
                                <tr>
                                    <td class="fw-bold">@season</td>
                                    <td class="@(L.AvgRating > R.AvgRating ? "text-success fw-semibold" : "text-muted small")">@L.AvgRating.ToString("F1")</td>
                                    <td class="@(R.AvgRating > L.AvgRating ? "text-success fw-semibold" : "text-muted small")">@R.AvgRating.ToString("F1")</td>
                                    <td class="@(L.MatchesPlayed > R.MatchesPlayed ? "text-success fw-semibold" : "text-muted small")">@L.MatchesPlayed</td>
                                    <td class="@(R.MatchesPlayed > L.MatchesPlayed ? "text-success fw-semibold" : "text-muted small")">@R.MatchesPlayed</td>
                                    <td class="@(lGoalStat > rGoalStat ? "text-success fw-semibold" : "text-muted small")">@lGoalDisplay</td>
                                    <td class="@(rGoalStat > lGoalStat ? "text-success fw-semibold" : "text-muted small")">@rGoalDisplay</td>
                                    <td class="@(L.Assists > R.Assists ? "text-success fw-semibold" : "text-muted small")">@L.Assists</td>
                                    <td class="@(R.Assists > L.Assists ? "text-success fw-semibold" : "text-muted small")">@R.Assists</td>
                                    <td class="@(L.WinRatioWith > R.WinRatioWith ? "text-success fw-semibold" : "text-muted small")">@L.WinRatioWith</td>
                                    <td class="@(R.WinRatioWith > L.WinRatioWith ? "text-success fw-semibold" : "text-muted small")">@R.WinRatioWith</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else if (_leftPlayer is not null || _rightPlayer is not null)
    {
        <div class="ui-panel ui-anim-fade-up p-3">
            <div class="d-flex align-items-center gap-2 text-muted">
                <i class="bi bi-info-circle"></i>
                <span>Vyber oba hráče pro zobrazení srovnání.</span>
            </div>
        </div>
    }
}

@code {
    private record RadarItem(string Label, double Left, double Right);

    private readonly ApexChartOptions<RadarItem> _radarOptions = new()
    {
        Chart  = new ApexCharts.Chart { Toolbar = new Toolbar { Show = false }, Background = "transparent" },
        Theme  = new ApexCharts.Theme { Mode = Mode.Dark },
        Colors = ["#a5b4fc", "#fca5a5"],
        Fill   = new Fill { Opacity = [0.2, 0.2] },
        Stroke = new Stroke { Width = [2, 2] },
        Grid   = new Grid  { BorderColor = "rgba(255,255,255,0.08)" },
        Yaxis  = [new YAxis { Max = 100, Min = 0, Show = false }],
    };

    private static RenderFragment CompareRow(string label, double left, double right, bool higher)
    {
        bool lWins = higher ? left > right : left < right;
        bool rWins = higher ? right > left : right < left;
        return __builder =>
        {
            __builder.OpenElement(0, "tr");
            __builder.OpenElement(1, "td");
            if (lWins) __builder.AddAttribute(2, "class", "fw-bold text-success");
            else __builder.AddAttribute(2, "class", "text-muted small");
            __builder.AddContent(3, left.ToString("G4"));
            __builder.CloseElement();
            __builder.OpenElement(4, "td");
            __builder.AddAttribute(5, "class", "text-center text-muted small");
            __builder.AddContent(6, label);
            __builder.CloseElement();
            __builder.OpenElement(7, "td");
            if (rWins) __builder.AddAttribute(8, "class", "text-end fw-bold text-success");
            else __builder.AddAttribute(8, "class", "text-end text-muted small");
            __builder.AddContent(9, right.ToString("G4"));
            __builder.CloseElement();
            __builder.CloseElement();
        };
    }

    private static RenderFragment CompareRow(string label, int left, int right, bool higher) =>
        CompareRow(label, (double)left, (double)right, higher);

    private static double NormOvr(double v)     => Math.Clamp((v - 50) / 50.0 * 100, 0, 100);
    private static double NormRating(double v)  => Math.Clamp((v - 5) / 5.0 * 100, 0, 100);
    private static double NormMatches(double v) => Math.Clamp(v / 30.0 * 100, 0, 100);
    private static double NormGoals(double v)   => Math.Clamp(v / 15.0 * 100, 0, 100);
    private static double NormWin(double v)     => Math.Clamp(v, 0, 100);

    private bool _loading = true;
    List<TopElevenPlayer> _players = new();

    Guid? _leftId;
    TopElevenPlayer? _leftPlayer;
    List<TopElevenSeasonStats> _leftStats = new();

    Guid? _rightId;
    TopElevenPlayer? _rightPlayer;
    List<TopElevenSeasonStats> _rightStats = new();

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _players = await db.TopElevenPlayers
            .OrderByDescending(p => p.Ovr)
            .ToListAsync();
        _loading = false;
    }

    async Task OnLeftChanged(ChangeEventArgs e)
    {
        _leftId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        _leftPlayer = null;
        _leftStats = new();

        if (_leftId is null) return;

        _leftPlayer = _players.FirstOrDefault(p => p.Guid == _leftId);

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _leftStats = await db.TopElevenSeasonStats
                .Where(s => s.PlayerId == _leftId)
                .OrderBy(s => s.Season)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError("Chyba", $"Nepodařilo se načíst statistiky: {ex.Message}");
        }

        StateHasChanged();
    }

    async Task OnRightChanged(ChangeEventArgs e)
    {
        _rightId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        _rightPlayer = null;
        _rightStats = new();

        if (_rightId is null) return;

        _rightPlayer = _players.FirstOrDefault(p => p.Guid == _rightId);

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _rightStats = await db.TopElevenSeasonStats
                .Where(s => s.PlayerId == _rightId)
                .OrderBy(s => s.Season)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError("Chyba", $"Nepodařilo se načíst statistiky: {ex.Message}");
        }

        StateHasChanged();
    }
}
