@page "/players"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContextGames> DbFactory
@inject ToastService Toast
@inject IJSRuntime JS
@inject AchievementService Achievements

<PageTitle>Hráči — TopElevenStats</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-people-fill"></i> Hráči</h3>
    @if (_account is not null)
    {
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-success" @onclick="ExportCsvAsync">
                <i class="bi bi-download me-1"></i>Export CSV
            </button>
            <button class="btn btn-sm btn-primary" @onclick="() => _showForm = !_showForm">
                <i class="bi bi-plus-lg me-1"></i>Přidat hráče
            </button>
        </div>
    }
</div>

<ConfirmDialog @ref="_confirmDialog" />

@if (_account is null)
{
    <div class="ui-panel ui-anim-fade-up">
        <div class="ui-panel-header">
            <span class="ui-panel-title">
                <i class="bi bi-person-plus text-accent"></i>
                Vytvořit účet
            </span>
        </div>
        <div class="p-3">
            <p class="text-muted small mb-3">Nejprve si vytvoř účet pro správu hráčů.</p>
            <div class="d-flex gap-2" style="max-width:360px">
                <input class="form-control form-control-sm" placeholder="Název účtu" @bind="_newAccountName" />
                <button class="btn btn-primary btn-sm" @onclick="CreateAccount">Vytvořit</button>
            </div>
        </div>
    </div>
}
else
{
    <!-- Add Player form -->
    @if (_showForm)
    {
        <div class="ui-panel ui-anim-fade-up">
            <div class="ui-panel-header">
                <span class="ui-panel-title">
                    <i class="bi bi-plus-circle text-accent"></i>
                    Nový hráč
                </span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showForm = false">Zrušit</button>
            </div>
            <div class="p-3">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small text-muted">Jméno</label>
                        <input class="form-control form-control-sm" @bind="_form.Name" placeholder="Jméno hráče" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small text-muted">OVR</label>
                        <input type="number" class="form-control form-control-sm" @bind="_form.Ovr" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small text-muted">Věk</label>
                        <input type="number" class="form-control form-control-sm" @bind="_form.Age" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Občanství</label>
                        <input class="form-control form-control-sm" @bind="_form.Citizenship" placeholder="CZE" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Role (např. GK, AML,ML)</label>
                        <input class="form-control form-control-sm" @bind="_form.Roles" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted">Spec. schopnost</label>
                        <input class="form-control form-control-sm" @bind="_form.SpecialAbility" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-4 align-items-center">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_form.IsGoalkeeper" id="isGk" />
                        <label class="form-check-label small" for="isGk">Brankář</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="_form.IsElite" id="isElite" />
                        <label class="form-check-label small" for="isElite">Elitní</label>
                    </div>
                    <button class="btn btn-success btn-sm" @onclick="AddPlayer">
                        <i class="bi bi-check-lg me-1"></i>Uložit
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-3">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <span class="text-muted">Načítám hráče…</span>
        </div>
    }
    else
    {
        <UiSearchBar @bind-Value="_search" Placeholder="Hledat jménem…"
                     Count="_totalItems" CountLabel="hráčů"
                     OnSearch="OnSearchChanged">
            <div class="d-flex gap-3 align-items-center">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="filterElite"
                           @bind="_filterElite" @bind:after="OnSearchChanged" />
                    <label class="form-check-label small" for="filterElite">Elitní</label>
                </div>
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="filterGk"
                           @bind="_filterGk" @bind:after="OnSearchChanged" />
                    <label class="form-check-label small" for="filterGk">Brankář</label>
                </div>
            </div>
        </UiSearchBar>

        <div class="ui-panel ui-anim-fade-up">
            <div class="ui-panel-header">
                <span class="ui-panel-title">
                    <i class="bi bi-people-fill text-accent"></i>
                    Seznam hráčů
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Jméno</th>
                            <th class="text-center">OVR</th>
                            <th class="text-center">Věk</th>
                            <th>Role</th>
                            <th>Spec.</th>
                            <th class="text-center">Elitní</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!_players.Any())
                        {
                            <tr><td colspan="7" class="text-muted text-center py-4">Žádní hráči.</td></tr>
                        }
                        @foreach (var p in _players)
                        {
                            <tr>
                                <td class="fw-semibold">@p.Name</td>
                                <td class="text-center"><span class="badge bg-secondary">@p.Ovr</span></td>
                                <td class="text-center text-muted small">@p.Age</td>
                                <td>
                                    <span class="badge @(p.IsGoalkeeper ? "bg-success" : "bg-secondary")">@p.Roles</span>
                                </td>
                                <td class="text-muted small">@p.SpecialAbility</td>
                                <td class="text-center">
                                    @if (p.IsElite)
                                    { <i class="bi bi-star-fill text-warning"></i> }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDelete(p.Guid)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="px-3 py-2 border-top border-opacity-10">
                <Paginator TotalItems="_totalItems" PageSize="PageSize" CurrentPage="_page"
                           OnPageChanged="async p => { _page = p; await LoadPlayersAsync(); }" />
            </div>
        </div>
    }
}

@code {
    private ConfirmDialog _confirmDialog = default!;
    private Guid _pendingDeleteId;

    TopElevenAccount? _account;
    List<TopElevenPlayer> _players = new();
    bool _showForm;
    string _newAccountName = "Můj účet";
    TopElevenPlayer _form = new();

    private bool _loading = true;
    private int _page = 1;
    private const int PageSize = 20;
    private int _totalItems;

    string _search = "";
    bool _filterElite;
    bool _filterGk;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _account = await db.TopElevenAccounts.FirstOrDefaultAsync();
        if (_account is not null)
            await LoadPlayersAsync();
        _loading = false;
    }

    private async Task LoadPlayersAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (_account is null) return;
        var query = db.TopElevenPlayers
            .Where(p => p.AccountId == _account.Guid)
            .AsQueryable();
        if (!string.IsNullOrWhiteSpace(_search))
            query = query.Where(p => p.Name.Contains(_search));
        if (_filterElite)
            query = query.Where(p => p.IsElite);
        if (_filterGk)
            query = query.Where(p => p.IsGoalkeeper);
        query = query.OrderByDescending(p => p.Ovr);
        _totalItems = await query.CountAsync();
        _players = await query
            .Skip((_page - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private async Task OnSearchChanged()
    {
        _page = 1;
        await LoadPlayersAsync();
        StateHasChanged();
        if (!string.IsNullOrWhiteSpace(_search)) await Achievements.CheckAsync("SEARCH_PLAYERS");
        if (_filterElite) await Achievements.CheckAsync("FILTER_ELITE");
        if (_filterGk) await Achievements.CheckAsync("FILTER_GK");
    }

    async Task CreateAccount()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var acc = new TopElevenAccount { Name = _newAccountName, CurrentSeason = 1 };
        db.TopElevenAccounts.Add(acc);
        await db.SaveChangesAsync();
        _account = acc;
        Toast.ShowSuccess("Účet vytvořen!", string.Empty);
        StateHasChanged();
    }

    async Task AddPlayer()
    {
        if (string.IsNullOrWhiteSpace(_form.Name)) { Toast.ShowError("Chyba", "Jméno je povinné."); return; }
        await using var db = await DbFactory.CreateDbContextAsync();
        _form.AccountId = _account!.Guid;
        db.TopElevenPlayers.Add(_form);
        await db.SaveChangesAsync();
        _players.Insert(0, _form);
        var savedForm = _form;
        _form = new();
        _showForm = false;
        Toast.ShowSuccess("Hráč přidán!", string.Empty);

        await Achievements.CheckAsync("FIRST_PLAYER");
        var count = await db.TopElevenPlayers.CountAsync(p => p.AccountId == _account!.Guid);
        if (count >= 5) await Achievements.CheckAsync("PLAYERS_5");
        if (count >= 10) await Achievements.CheckAsync("PLAYERS_10");
        if (count >= 25) await Achievements.CheckAsync("PLAYERS_25");
        if (count >= 50) await Achievements.CheckAsync("PLAYERS_50");
        if (count >= 100) await Achievements.CheckAsync("PLAYERS_100");
        if (count >= 200) await Achievements.CheckAsync("PLAYERS_200");
        if (count >= 500) await Achievements.CheckAsync("PLAYERS_500");
        if (savedForm.IsElite) await Achievements.CheckAsync("FIRST_ELITE");
        if (savedForm.IsGoalkeeper) await Achievements.CheckAsync("FIRST_GK");
        if (!string.IsNullOrEmpty(savedForm.Citizenship) && savedForm.Citizenship.Equals("CZE", StringComparison.OrdinalIgnoreCase))
            await Achievements.CheckAsync("CITIZENSHIP_CZE");
        if (!string.IsNullOrEmpty(savedForm.Roles) && savedForm.Roles.Contains(','))
            await Achievements.CheckAsync("MULTI_ROLE");
        if (savedForm.IsGoalkeeper && savedForm.Age < 22) await Achievements.CheckAsync("GK_YOUNG");
        if (savedForm.IsGoalkeeper && savedForm.Age > 35) await Achievements.CheckAsync("GK_VETERAN");
        if (savedForm.IsGoalkeeper && string.IsNullOrEmpty(savedForm.SpecialAbility)) await Achievements.CheckAsync("GK_NO_ABILITY");
        if (savedForm.IsGoalkeeper && !string.IsNullOrEmpty(savedForm.SpecialAbility)) await Achievements.CheckAsync("GK_ABILITY");
        if (savedForm.IsElite && savedForm.IsGoalkeeper) await Achievements.CheckAsync("ELITE_GK");
        if (savedForm.IsElite && !string.IsNullOrEmpty(savedForm.Citizenship) && savedForm.Citizenship.Equals("CZE", StringComparison.OrdinalIgnoreCase))
            await Achievements.CheckAsync("ELITE_CZECH");
        if (savedForm.IsElite && !string.IsNullOrEmpty(savedForm.SpecialAbility)) await Achievements.CheckAsync("ELITE_SPECIAL");
        if (savedForm.Ovr >= 70) await Achievements.CheckAsync("OVR_70");
        if (savedForm.Ovr >= 75) await Achievements.CheckAsync("OVR_75");
        if (savedForm.Ovr >= 80) await Achievements.CheckAsync("OVR_80");
        if (savedForm.Ovr >= 85) await Achievements.CheckAsync("OVR_85");
        if (savedForm.Ovr >= 90) await Achievements.CheckAsync("OVR_90");
        if (savedForm.Ovr >= 95) await Achievements.CheckAsync("OVR_95");
        if (savedForm.Ovr >= 100) await Achievements.CheckAsync("OVR_100");
    }

    private async Task ConfirmDelete(Guid id)
    {
        _pendingDeleteId = id;
        var confirmed = await _confirmDialog.ShowAsync("Smazat hráče", "Opravdu chcete smazat tohoto hráče? Tato akce je nevratná.");
        if (confirmed) await ExecuteDelete(_pendingDeleteId);
    }

    private async Task ExecuteDelete(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var p = await db.TopElevenPlayers.FindAsync(id);
        if (p is null) return;
        db.TopElevenPlayers.Remove(p);
        await db.SaveChangesAsync();
        _players.RemoveAll(x => x.Guid == id);
        Toast.ShowSuccess("Hráč odstraněn.", string.Empty);
        await Achievements.CheckAsync("DELETE_PLAYER");
    }

    private async Task ExportCsvAsync()
    {
        if (_account is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var allPlayers = await db.TopElevenPlayers
            .Where(p => p.AccountId == _account.Guid)
            .OrderBy(p => p.Name)
            .ToListAsync();
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Jméno,OVR,Věk,Role,Spec. schopnost,Elitní,Brankář,Občanství");
        foreach (var p in allPlayers)
            sb.AppendLine($"\"{p.Name?.Replace("\"", "\"\"")}\",{p.Ovr},{p.Age},\"{p.Roles?.Replace("\"", "\"\"")}\",\"{p.SpecialAbility?.Replace("\"", "\"\"")}\",{p.IsElite},{p.IsGoalkeeper},\"{p.Citizenship?.Replace("\"", "\"\"")}\"");
        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        await JS.InvokeVoidAsync("downloadBase64File", "hrace.csv", "text/csv", Convert.ToBase64String(bytes));
        await Achievements.CheckAsync("FIRST_EXPORT");
        await Achievements.CheckAsync("EXPORT_CSV");
    }
}
