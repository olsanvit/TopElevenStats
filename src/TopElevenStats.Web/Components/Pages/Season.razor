@page "/season"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<AppDbContextGames> DbFactory
@inject ToastService Toast

<PageTitle>Správa sezóny — TopElevenStats</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-calendar3"></i> Správa sezóny</h3>
</div>

<ConfirmDialog @ref="_confirmDialog" />

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Načítám sezónu…</span>
    </div>
}
else if (_account is null)
{
    <div class="ui-panel ui-anim-fade-up p-3">
        <div class="d-flex align-items-center gap-2 text-warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>Nejprve vytvoř účet v sekci Hráči.</span>
        </div>
    </div>
}
else
{
    <!-- Current season card -->
    <div class="ui-panel ui-anim-fade-up">
        <div class="ui-panel-header">
            <span class="ui-panel-title">
                <i class="bi bi-calendar-check text-accent"></i>
                Aktuální sezóna
            </span>
        </div>
        <div class="p-4 text-center">
            <div class="fw-bold mb-2" style="font-size:3.5rem;color:var(--ui-accent)">@_account.CurrentSeason</div>
            <p class="text-muted small mb-4">Po dokončení importu statistik z Top Eleven klikni na tlačítko níže.</p>
            <button class="btn btn-warning" @onclick="IncreaseSeason">
                <i class="bi bi-arrow-up-circle me-2"></i>Nová sezóna +1
            </button>
        </div>
    </div>

    <!-- Seasons overview table -->
    <div class="ui-panel ui-anim-fade-up">
        <div class="ui-panel-header">
            <span class="ui-panel-title">
                <i class="bi bi-list-ol text-accent"></i>
                Přehled sezón
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Sezóna</th>
                        <th class="text-center">Hráči se statistikami</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_seasonSummary.Any())
                    {
                        <tr><td colspan="3" class="text-muted text-center py-4">Žádné statistiky.</td></tr>
                    }
                    @foreach (var s in _seasonSummary)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @s.Season
                                @if (s.Season == _account.CurrentSeason)
                                {
                                    <span class="badge bg-primary ms-2">aktuální</span>
                                }
                            </td>
                            <td class="text-center text-muted small">@s.Count</td>
                            <td class="text-end">
                                <button class="btn btn-outline-danger btn-sm"
                                        @onclick="() => ConfirmDeleteSeason(s.Season)"
                                        title="Smazat všechny statistiky za sezónu @s.Season">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private ConfirmDialog _confirmDialog = default!;
    private int _pendingDeleteSeason;

    TopElevenAccount? _account;
    List<(int Season, int Count)> _seasonSummary = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        _loading = false;
    }

    async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _account = await db.TopElevenAccounts.FirstOrDefaultAsync();
        if (_account is null) return;
        var raw = await db.TopElevenSeasonStats
            .Where(s => s.Player.AccountId == _account.Guid)
            .GroupBy(s => s.Season)
            .Select(g => new { Season = g.Key, Count = g.Count() })
            .OrderByDescending(g => g.Season)
            .ToListAsync();
        _seasonSummary = raw.Select(x => (x.Season, x.Count)).ToList();
    }

    private async Task ConfirmDeleteSeason(int season)
    {
        _pendingDeleteSeason = season;
        var confirmed = await _confirmDialog.ShowAsync(
            "Smazat statistiky sezóny",
            $"Opravdu chcete smazat všechny statistiky za sezónu {season}? Tato akce je nevratná.");
        if (confirmed)
            await ExecuteDeleteSeason(_pendingDeleteSeason);
    }

    private async Task ExecuteDeleteSeason(int season)
    {
        if (_account is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var stats = await db.TopElevenSeasonStats
            .Where(s => s.Player.AccountId == _account.Guid && s.Season == season)
            .ToListAsync();
        if (stats.Count == 0) return;
        db.TopElevenSeasonStats.RemoveRange(stats);
        await db.SaveChangesAsync();
        Toast.ShowSuccess($"Smazáno {stats.Count} záznamů za sezónu {season}.", string.Empty);
        await Load();
    }

    async Task IncreaseSeason()
    {
        if (_account is null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var acc = await db.TopElevenAccounts.FindAsync(_account.Guid);
        if (acc is null) return;
        acc.CurrentSeason++;
        await db.SaveChangesAsync();
        _account.CurrentSeason = acc.CurrentSeason;
        Toast.ShowSuccess($"Sezóna posunuta na {acc.CurrentSeason}!", string.Empty);
        await Load();
    }
}
