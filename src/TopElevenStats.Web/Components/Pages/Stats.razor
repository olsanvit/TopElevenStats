@page "/stats"
@rendermode InteractiveServer
@using ApexCharts
@inject IDbContextFactory<AppDbContextGames> DbFactory
@inject ToastService Toast

<PageTitle>Statistiky — TopElevenStats</PageTitle>

<div class="ui-page-header ui-anim-fade-up">
    <h3><i class="bi bi-graph-up"></i> Statistiky hráče</h3>
</div>

@if (_loading)
{
    <div class="ui-anim-fade-up d-flex align-items-center gap-2 mt-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="text-muted">Načítám hráče…</span>
    </div>
}
else
{
    <!-- Player selector -->
    <div class="ui-panel ui-anim-fade-up">
        <div class="ui-panel-header">
            <span class="ui-panel-title">
                <i class="bi bi-person-circle text-accent"></i>
                Výběr hráče
            </span>
        </div>
        <div class="p-3">
            <select class="form-select form-select-sm"
                    style="max-width:420px;background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.1);color:var(--ui-text-1)"
                    value="@_selectedPlayerId" @onchange="OnPlayerChanged">
                <option value="">— vyber hráče —</option>
                @foreach (var p in _players)
                {
                    <option value="@p.Guid">@p.Name (@p.Roles) OVR @p.Ovr@(p.IsGoalkeeper ? " · GK" : "")@(p.IsElite ? " · ELITE" : "")</option>
                }
            </select>
        </div>
    </div>

    @if (_selectedPlayer is not null && _stats.Count > 0)
    {
        <!-- Player header badges -->
        <div class="d-flex align-items-center gap-2 mb-3 ui-anim-fade-up">
            <a href="/players/@_selectedPlayer.Guid" class="text-decoration-none fw-semibold fs-5">@_selectedPlayer.Name</a>
            <span class="badge bg-secondary">OVR @_selectedPlayer.Ovr</span>
            @if (_selectedPlayer.IsGoalkeeper) { <span class="badge bg-success">GK</span> }
            @if (_selectedPlayer.IsElite) { <span class="badge bg-warning text-dark">ELITNÍ</span> }
        </div>

        <!-- Charts -->
        <div class="row g-3 ui-anim-fade-up">
            <div class="col-12 col-lg-6">
                <div class="ui-panel">
                    <div class="ui-panel-header">
                        <span class="ui-panel-title">
                            <i class="bi bi-graph-up text-accent"></i>
                            Průměrné hodnocení
                        </span>
                    </div>
                    <ApexChart TItem="TopElevenSeasonStats" Options="_ratingChartOptions">
                        <ApexPointSeries TItem="TopElevenSeasonStats"
                                         Items="_stats"
                                         Name="Avg Rating"
                                         XValue="@(s => s.Season)"
                                         YValue="@(s => s.AvgRating)"
                                         SeriesType="SeriesType.Line" />
                        <ApexPointSeries TItem="TopElevenSeasonStats"
                                         Items="_stats"
                                         Name="Výhry s hráčem %"
                                         XValue="@(s => s.Season)"
                                         YValue="@(s => s.WinRatioWith)"
                                         SeriesType="SeriesType.Line" />
                    </ApexChart>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="ui-panel">
                    <div class="ui-panel-header">
                        <span class="ui-panel-title">
                            <i class="bi bi-activity text-accent"></i>
                            Výkon
                        </span>
                    </div>
                    <ApexChart TItem="TopElevenSeasonStats" Options="_performanceChartOptions">
                        @if (_selectedPlayer.IsGoalkeeper)
                        {
                            <ApexPointSeries TItem="TopElevenSeasonStats"
                                             Items="_stats"
                                             Name="Čistá konta"
                                             XValue="@(s => s.Season)"
                                             YValue="@(s => s.CleanSheets ?? 0)"
                                             SeriesType="SeriesType.Line" />
                        }
                        else
                        {
                            <ApexPointSeries TItem="TopElevenSeasonStats"
                                             Items="_stats"
                                             Name="Góly"
                                             XValue="@(s => s.Season)"
                                             YValue="@(s => s.Goals ?? 0)"
                                             SeriesType="SeriesType.Line" />
                        }
                        <ApexPointSeries TItem="TopElevenSeasonStats"
                                         Items="_stats"
                                         Name="Asistence"
                                         XValue="@(s => s.Season)"
                                         YValue="@(s => s.Assists)"
                                         SeriesType="SeriesType.Line" />
                    </ApexChart>
                </div>
            </div>
        </div>

        <!-- Season overview table -->
        <div class="ui-panel ui-anim-fade-up">
            <div class="ui-panel-header">
                <span class="ui-panel-title">
                    <i class="bi bi-table text-accent"></i>
                    Přehled sezón
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Sezóna</th>
                            <th class="text-center">Hodnocení</th>
                            <th class="text-center">Zápasy</th>
                            @if (_selectedPlayer.IsGoalkeeper)
                            {
                                <th class="text-center">Čistá konta</th>
                            }
                            else
                            {
                                <th class="text-center">Góly</th>
                                <th class="text-center">xG/90</th>
                            }
                            <th class="text-center">Asistence</th>
                            <th class="text-center">Klíč. přihr.</th>
                            <th class="text-center">Zranění</th>
                            <th class="text-center">ŽK</th>
                            <th class="text-center">ČK</th>
                            <th class="text-center">S hráčem %</th>
                            <th class="text-center">Bez hráče %</th>
                            <th class="text-center">Týmový %</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _stats)
                        {
                            <tr>
                                <td class="fw-bold">@s.Season</td>
                                <td class="text-center">@s.AvgRating.ToString("F1")</td>
                                <td class="text-center text-muted small">@s.MatchesPlayed</td>
                                @if (_selectedPlayer.IsGoalkeeper)
                                {
                                    <td class="text-center text-muted small">@(s.CleanSheets?.ToString() ?? "—")</td>
                                }
                                else
                                {
                                    <td class="text-center text-muted small">@(s.Goals?.ToString() ?? "—")</td>
                                    <td class="text-center text-muted small">@(s.Xg90?.ToString("F2") ?? "—")</td>
                                }
                                <td class="text-center text-muted small">@s.Assists</td>
                                <td class="text-center text-muted small">@s.KeyPasses.ToString("F1")</td>
                                <td class="text-center text-muted small">@s.Injuries</td>
                                <td class="text-center text-muted small">@s.YellowCards</td>
                                <td class="text-center text-muted small">@s.RedCards</td>
                                <td class="text-center text-muted small">@s.WinRatioWith</td>
                                <td class="text-center text-muted small">@s.WinRatioWithout</td>
                                <td class="text-center text-muted small">@s.TeamAverage</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (_selectedPlayer is not null && _stats.Count == 0)
    {
        <div class="ui-panel ui-anim-fade-up p-3">
            <div class="d-flex align-items-center gap-2 text-muted">
                <i class="bi bi-info-circle"></i>
                <span>Pro tohoto hráče zatím nejsou žádné statistiky.</span>
            </div>
        </div>
    }
}

@code {
    private bool _loading = true;
    List<TopElevenPlayer> _players = new();
    Guid? _selectedPlayerId;
    TopElevenPlayer? _selectedPlayer;
    List<TopElevenSeasonStats> _stats = new();

    ApexChartOptions<TopElevenSeasonStats> _ratingChartOptions = new()
    {
        Chart   = new Chart   { Toolbar = new Toolbar { Show = false }, Background = "transparent" },
        Theme   = new ApexCharts.Theme { Mode = Mode.Dark },
        Colors  = ["#6366f1", "#10b981"],
        Grid    = new Grid    { BorderColor = "rgba(255,255,255,0.08)" },
        Stroke  = new Stroke  { Curve = Curve.Smooth, Width = new List<int> { 3, 3 } },
        Markers = new Markers { Size = new List<int> { 5 } },
        Xaxis   = new XAxis   { Title = new AxisTitle { Text = "Sezóna" } },
        Yaxis   = new List<YAxis> { new YAxis { Title = new AxisTitle { Text = "Hodnota" }, DecimalsInFloat = 2 } }
    };

    ApexChartOptions<TopElevenSeasonStats> _performanceChartOptions = new()
    {
        Chart   = new Chart   { Toolbar = new Toolbar { Show = false }, Background = "transparent" },
        Theme   = new ApexCharts.Theme { Mode = Mode.Dark },
        Colors  = ["#f59e0b", "#06b6d4"],
        Grid    = new Grid    { BorderColor = "rgba(255,255,255,0.08)" },
        Stroke  = new Stroke  { Curve = Curve.Smooth, Width = new List<int> { 3, 3 } },
        Markers = new Markers { Size = new List<int> { 5 } },
        Xaxis   = new XAxis   { Title = new AxisTitle { Text = "Sezóna" } },
        Yaxis   = new List<YAxis> { new YAxis { Title = new AxisTitle { Text = "Počet" }, DecimalsInFloat = 0 } }
    };

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _players = await db.TopElevenPlayers
            .OrderByDescending(p => p.Ovr)
            .ToListAsync();
        _loading = false;
    }

    async Task OnPlayerChanged(ChangeEventArgs e)
    {
        _selectedPlayerId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : (Guid?)null;
        _selectedPlayer = null;
        _stats = new();

        if (_selectedPlayerId is null) return;

        _selectedPlayer = _players.FirstOrDefault(p => p.Guid == _selectedPlayerId);

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            _stats = await db.TopElevenSeasonStats
                .Where(s => s.PlayerId == _selectedPlayerId)
                .OrderBy(s => s.Season)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Toast.ShowError("Chyba", $"Nepodařilo se načíst statistiky: {ex.Message}");
        }

        StateHasChanged();
    }
}
